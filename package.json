{
  "name": "browse-assist",
  "displayName": "__MSG_extName__",
  "version": "1.1.0",
  "description": "__MSG_extDescription__",
  "slogan": "Supercharge Your Web Browsing",
  "homepage": "https://www.trongajtt.com/apps/browse-assist",
  "termsUrl": "https://www.trongajtt.com/apps/browse-assist/terms",
  "privacyPolicyUrl": "https://www.trongajtt.com/apps/browse-assist/policy",
  "author": "TrongAJTT. <trong.ajtt.dev@gmail.com>",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "plasmo dev",
    "dev:firefox": "plasmo dev --target=firefox-mv3",
    "dev:edge": "plasmo dev --target=edge-mv3",
    "dev:chrome": "plasmo dev --target=chrome-mv3",
    "build": "plasmo build",
    "package": "plasmo package",
    "package:edge": "plasmo build --target=edge-mv3 && plasmo package --target=edge-mv3",
    "package:firefox": "plasmo build --target=firefox-mv3 && plasmo package --target=firefox-mv3",
    "package:chrome": "plasmo build --target=chrome-mv3 && plasmo package --target=chrome-mv3",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:icon": "node scripts/generate-icon.mjs"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.15.0",
    "lucide-react": "^1.41.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "rosetta": "^1.1.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.5.5",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.28",
    "prettier": "3.2.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.19",
    "typescript": "5.3.3",
    "vitest": "^2.1.8"
  },
  "manifest": {
    "default_locale": "en",
    "permissions": [
      "storage",
      "contextMenus",
      "clipboardWrite",
      "search"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "browse-assist@trongajtt.com",
        "strict_min_version": "109.0",
        "data_collection_permissions": {
          "required": [
            "none"
          ]
        }
      }
    },
    "commands": {
      "toggle_picture_in_picture": {
        "suggested_key": {
          "default": "Alt+P",
          "mac": "Alt+P"
        },
        "description": "__MSG_cmdPiP__"
      },
      "toggle_allow_right_click": {
        "suggested_key": {
          "default": "Alt+R",
          "mac": "Alt+R"
        },
        "description": "__MSG_cmdAllowRightClick__"
      },
      "toggle_color_picker": {
        "suggested_key": {
          "default": "Alt+Shift+C",
          "mac": "Alt+Shift+C"
        },
        "description": "__MSG_cmdColorPicker__"
      },
      "toggle_element_toys": {
        "suggested_key": {
          "default": "Alt+Shift+Z",
          "mac": "Alt+Shift+Z"
        },
        "description": "__MSG_cmdElementToys__"
      },
      "toggle_quick_hub": {
        "description": "__MSG_cmdQuickHub__"
      }
    },
    "overrides": {
      "firefox": {
        "permissions": [
          "storage",
          "contextMenus",
          "menus",
          "clipboardWrite",
          "search"
        ],
        "commands": {
          "toggle_picture_in_picture": {
            "suggested_key": {
              "default": "Alt+P",
              "mac": "Alt+P"
            },
            "description": "__MSG_cmdPiP__"
          },
          "toggle_allow_right_click": {
            "suggested_key": {
              "default": "Alt+R",
              "mac": "Alt+R"
            },
            "description": "__MSG_cmdAllowRightClick__"
          },
          "toggle_element_toys": {
            "suggested_key": {
              "default": "Alt+Shift+Z",
              "mac": "Alt+Shift+Z"
            },
            "description": "__MSG_cmdElementToys__"
          },
          "toggle_quick_hub": {
            "description": "__MSG_cmdQuickHub__"
          }
        }
      }
    }
  }
}
